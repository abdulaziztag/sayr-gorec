# Настройки sayr-gorets. Скопируйте в .env (chmod 600) и заполните.
# Префикс GORETS_ обязателен для всех ключей, кроме ANTHROPIC_API_KEY.
# Лишние ключи игнорируются.

# --- База -----------------------------------------------------------------
# Своя база и роль в том же Postgres, что у сервера Sayr.
GORETS_DATABASE_URL=postgresql+psycopg://sayr_gorets:ПАРОЛЬ@localhost:5432/sayr_gorets

# --- Telegram (MTProto, обычный аккаунт) ----------------------------------
# api_id и api_hash с https://my.telegram.org (раздел API development tools).
GORETS_TG_API_ID=
GORETS_TG_API_HASH=
# Строка сессии: допишет `gorets login`. Никогда не копируйте SAYR_TG_SESSION
# сервера Sayr — два клиента на одном ключе Telegram может разорвать.
# GORETS_TG_SESSION=
# Чаты для сбора через запятую: username без @ или числовой id.
# Аккаунт-сборщик должен состоять в каждом из них.
GORETS_CHATS=gorets_uzb,hikinguz
# Чат, которого ещё нет в базе, при первом сборе читается с этой даты (по Ташкенту),
# дальше — только новые сообщения. Чтобы история не удалилась сразу,
# GORETS_RETENTION_DAYS должен покрывать этот срок.
GORETS_INITIAL_SINCE=2026-01-01
# Кому слать отчёт: @username или числовой id. Владелец должен первым написать
# аккаунту-сборщику (или добавить его в контакты), иначе антиспам.
GORETS_OWNER=
# Пауза между запросами к Telegram, секунды (1–2 с достаточно).
GORETS_REQUEST_PAUSE=1.5
# Сколько секунд FloodWait пережидаем; дольше — ошибка и продолжение завтра.
GORETS_FLOOD_WAIT_MAX=3600
# Порция `gorets backfill` за один запуск.
GORETS_BACKFILL_BATCH=5000

# --- Хранение ---------------------------------------------------------------
# Секрет для HMAC от id авторов. Придумайте длинный (openssl rand -hex 32)
# и не меняйте: иначе forget-author не найдёт старые записи.
GORETS_AUTHOR_HMAC_SECRET=
# Сырые сообщения старше этого срока удаляются; итоги недель хранятся всегда.
GORETS_RETENTION_DAYS=90
# @упоминания и ссылки t.me, которые не считаем людьми (каналы, боты), через запятую.
GORETS_MENTION_KEEP=

# --- Разбор недели (Claude) ------------------------------------------------
ANTHROPIC_API_KEY=
GORETS_CHUNK_MODEL=claude-haiku-4-5-20251001
GORETS_SYNTHESIS_MODEL=claude-sonnet-5-5
# Бюджет входных токенов одного куска и грубая оценка «символов на токен».
GORETS_CHUNK_TOKEN_BUDGET=12000
GORETS_CHARS_PER_TOKEN=2.5
# Сколько часов ждём батч и как часто (секунды) его опрашиваем.
GORETS_BATCH_WAIT_HOURS=6
GORETS_BATCH_POLL_SECONDS=120
# JSON по схеме (structured outputs). Выключить, если модель это не поддерживает.
GORETS_STRUCTURED_OUTPUT=true
# Каталог мест Sayr и шаблон ссылки на место в отчёте.
GORETS_CATALOG_URL=https://sayr.info/api/v1/places
GORETS_PLACE_URL_TEMPLATE=https://sayr.info/p/{slug}
# Куда класть отчёты (в systemd — единственный каталог на запись).
GORETS_REPORTS_DIR=reports
GORETS_TIMEZONE=Asia/Tashkent
# Доставка: auto — частями, если их не больше GORETS_DELIVERY_MAX_PARTS, иначе файлом .md.
GORETS_DELIVERY=auto
GORETS_DELIVERY_MAX_PARTS=4

# --- Фиды, извлекатели, API для других проектов ---------------------------
# Описание фидов и извлекателей (файл в репозитории).
GORETS_CONFIG=gorets.toml
GORETS_EXTRACT_MODEL=claude-haiku-4-5-20251001
# Токен HTTP API (openssl rand -hex 32). Без него API не запускается.
GORETS_API_TOKEN=
GORETS_API_HOST=127.0.0.1
GORETS_API_PORT=8790

GORETS_LOG_LEVEL=INFO
